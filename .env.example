# Get BOT_TOKEN from @BotFather on Telegram -> /newbot
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get from https://thekclaut.com -> Login -> Account / API Key (top menu)
THEKCLAUT_API_KEY=your_api_key_here

# Optional: Your Telegram user ID (get via @userinfobot) for admin alerts on new orders
ADMIN_ID=

# Optional: Add profit markup % (e.g., 20 = charge 20% more than panel rate)
# 0 = no markup, sell at cost. 30 = 30% profit
MARKUP_PERCENT=0

# Optional: Currency label shown to users (actual currency is from panel: NGN/KES/GHS/USD)
CURRENCY_LABEL=USD
